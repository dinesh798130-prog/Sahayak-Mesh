# Sahayak Mesh — Environment Variables Example
# Copy this file to .env.local for local environment overrides

# Google Maps JavaScript API Key (Optional: system runs in offline fallback mode if omitted)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Default Campus Coordinates (SNIST Hyderabad)
NEXT_PUBLIC_CAMPUS_LAT=17.4529
NEXT_PUBLIC_CAMPUS_LNG=78.6754
